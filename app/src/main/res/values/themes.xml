<resources>
    <!-- شاشة الإطلاق: خلفية حبرية وصاعقة، بدون شعار مستطيل ولا تدرجات -->
    <style name="Theme.Barq.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_fg</item>
        <item name="postSplashScreenTheme">@style/Theme.Barq</item>
    </style>

    <style name="Theme.Barq" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
